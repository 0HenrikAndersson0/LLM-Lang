@1 @ns Humanizer

type DefaultCollectionFormatter(defaultSeparator String) : ICollectionFormatter{
  protected String DefaultSeparator=defaultSeparator
  export virtual fn Humanize<T>(collection IEnumerable<T>) String{Humanize(collection, o=>o?.ToString(), DefaultSeparator)}
  export virtual fn Humanize<T>(collection IEnumerable<T>, objectFormatter Func<T,String?>) String{Humanize(collection, objectFormatter, DefaultSeparator)}
  export fn Humanize<T>(collection IEnumerable<T>, objectFormatter Func<T,Object?>) String{Humanize(collection, objectFormatter, DefaultSeparator)}
  export virtual fn Humanize<T>(collection IEnumerable<T>, separator String) String{Humanize(collection, o=>o?.ToString(), separator)}
  export virtual fn Humanize<T>(collection IEnumerable<T>, objectFormatter Func<T,String?>, separator String) String{
    ArgumentNullException.ThrowIfNull(collection)
    ArgumentNullException.ThrowIfNull(objectFormatter)
    return HumanizeDisplayStrings(collection, objectFormatter, separator)
  }
  export fn Humanize<T>(collection IEnumerable<T>, objectFormatter Func<T,Object?>, separator String) String{
    ArgumentNullException.ThrowIfNull(collection)
    ArgumentNullException.ThrowIfNull(objectFormatter)
    return HumanizeDisplayObjects(collection, objectFormatter, separator)
  }
  fn HumanizeDisplayStrings<T>(collection IEnumerable<T>, objectFormatter Func<T,String?>, separator String) String{
    var items=CreateDisplayItems(collection)
    for item in collection{
      AddDisplayString(items, objectFormatter(item))
    }
    return HumanizeDisplayItems(items, separator)
  }
  fn HumanizeDisplayObjects<T>(collection IEnumerable<T>, objectFormatter Func<T,Object?>, separator String) String{
    var items=CreateDisplayItems(collection)
    for item in collection{
      AddDisplayString(items, objectFormatter(item)?.ToString())
    }
    return HumanizeDisplayItems(items, separator)
  }
  static fn CreateDisplayItems<T>(collection IEnumerable<T>) List<String>{
    collection switch{
      ICollection<T>items => new (items.Count)
      IReadOnlyCollection<T>items => new (items.Count)
      else []
    }
  }
  static fn AddDisplayString(items List<String>, item String?){
    if string.IsNullOrWhiteSpace(item){
      return
    }
    items.Add(item!.Trim())
  }
  fn HumanizeDisplayItems(items List<String>, separator String) String{
    var count=items.Count
    if count==0{
      return ""
    }
    if count==1{
      return items[0]
    }
    var conjunctionFormat=GetConjunctionFormatString(count)
    if conjunctionFormat=="{{0}} {{1}} {{2}}"{
      return count==2?string.Concat(items[0], " ", separator, " ", items[1]):string.Concat(JoinLeadingItems(items), " ", separator, " ", items[^1])
    }
    return string.Format(conjunctionFormat, JoinLeadingItems(items), separator, items[^1])
  }
  static fn JoinLeadingItems(items List<String>) String{
    var count=items.Count-1
    if count==1{
      return items[0]
    }
    var builder=new StringBuilder()
    builder.Append(items[0])
    for var i=1;i<count;i++{
      builder.Append(", ")
      builder.Append(items[i])
    }
    return builder.ToString()
  }
  protected virtual fn GetConjunctionFormatString(itemCount Int) String{"{{0}} {{1}} {{2}}"}
}
