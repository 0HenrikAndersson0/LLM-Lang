@1 @ns Humanizer

type RussianGrammaticalNumberDetector{
  fn Detect(Int64 number) RussianGrammaticalNumber{
    var tens = number % 100 / 10
    if tens != 1{
      var unity = number % 10
      // Teens are always plural; last digit matters only when tens != 1.
      if unity == 1{return RussianGrammaticalNumber.Singular}
      if unity is > 1 and < 5{return RussianGrammaticalNumber.Paucal}
    }
    RussianGrammaticalNumber.Plural
  }
}