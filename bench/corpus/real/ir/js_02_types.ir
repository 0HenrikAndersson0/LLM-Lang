@1 @ns Cheerio

// TS-only union/template types: expressed as opaque (unrepresentable in IR;
// printer re-emits the block verbatim)
opaque type LowercaseLetters = 'a'|'b'|'c'|'d'|'e'|'f'|'g'|'h'|'i'|'j'|'k'|'l'|'m'
  |'n'|'o'|'p'|'q'|'r'|'s'|'t'|'u'|'v'|'w'|'x'|'y'|'z'
opaque type AlphaNumeric = LowercaseLetters | Uppercase<LowercaseLetters> | `${number}`
opaque type SelectorSpecial = '.'|'#'|':'|'|'|'>'|'+'|'~'|'['
opaque type SelectorType = `${SelectorSpecial}${AlphaNumeric}${string}`
  | `${AlphaNumeric}${string}`

type BasicAcceptedElems<T extends AnyNode> = ArrayLike<T> | T | String

type FilterFunction<T> = (this: T, i: Int, el: T) => Bool
type AcceptedFilters<T> = String | FilterFunction<T> | T | Cheerio<T>