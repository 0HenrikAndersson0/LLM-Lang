@1 @use domhandler @use js

opaque type LowercaseLetters=|"a"|"b"|"c"|"d"|"e"|"f"|"g"|"h"|"i"|"j"|"k"|"l"|"m"|"n"|"o"|"p"|"q"|"r"|"s"|"t"|"u"|"v"|"w"|"x"|"y"|"z"
opaque type AlphaNumeric=|LowercaseLetters|Uppercase<LowercaseLetters>|"`${number}`"
opaque type SelectorSpecial="."|"#"|":"|"|"|">"|"+"|"~"|"["
opaque type SelectorType=|"`${SelectorSpecial}${AlphaNumeric}${string}`"|"`${AlphaNumeric}${string}`"
opaque type BasicAcceptedElems=ArrayLike<T>|T|String
opaque type AcceptedElems=|BasicAcceptedElems<T>|"opaque:(this: T, i: number, el: T) => BasicAcceptedElems<T>"
opaque type FilterFunction="opaque:(this: T, i: number, el: T) => boolean"
opaque type AcceptedFilters=String|FilterFunction<T>|T|Cheerio<T>
