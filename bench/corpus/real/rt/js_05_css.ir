@1 @use domhandler @use js

export fn css(this Cheerio<T>, prop: String|Array<String>|Record<String,String>?, val String?) Cheerio<T>|Record<String,String>|String|undefined{
  if (prop !=null &&val !=null )||(typeof prop==="object"&&!Array.isArray(prop)){
    return domEach(this, (el, i)=>{if isTag(el){setCss(el, prop as String, val, i)}})
  }
  if this.length===0{
    return
  }
  return getCss(this[0], prop as String)
}
fn setCss(el Element, prop: String|Record<String,String>, value: String|undefined, idx Int){
  if typeof prop==="string"{
    var styles=getCss(el)
    var val=typeof value==="function"?value.call(el, idx, styles[prop]):value
    if val===""{
      delete styles[prop]
    }else if val !=null{styles[prop]=val}
    el.attribs["style"]=stringify(styles)
  }else if typeof prop==="object"{
    var keys=Object.keys(prop)
    for i in 0..keys.length{
      var k=keys[i]
      setCss(el, k, prop[k], i)
    }

  }
}
fn getCss(el AnyNode, prop: String|Array<String>?) Record<String,String>|String|undefined{
  if !(el&&isTag(el)){return}
  var styles=parse(el.attribs["style"])
  if typeof prop==="string"{
    return styles[prop]
  }
  if Array.isArray(prop){
    var newStyles: Record<String,String> ={}
    for item in prop{
      if styles[item]!=null{newStyles[item]=styles[item]}
    }
    return newStyles
  }
  return styles
}
fn stringify(obj Record<String,String>) String{
  return Object.keys(obj).reduce((str, prop)=>"{str}{str?\" \":\"\"}{prop}: {obj[prop]};", "")
}
fn parse(styles String) Record<String,String>{
  styles=(styles||"").trim()
  if !styles{return {}}
  var obj: Record<String,String> ={}
  var mut key: String|undefined
  for str in styles.split(";"){
    var n=str.indexOf(":")
    if n<1||n===str.length-1{
      var trimmed=str.trimEnd()
      if trimmed.length>0&&key !==undefined{obj[key]+=";{trimmed}"}
    }else{
      key=str.slice(0, n).trim()
      obj[key]=str.slice(n+1).trim()

    }
  }
  return obj
}
