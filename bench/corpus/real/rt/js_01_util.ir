@1 @use domhandler @use js

export fn isCheerio(maybeCheerio Any) Bool{
  return ((maybeCheerio as Cheerio<T>|null |undefined)?.cheerio==="[cheerio object]")
}
export fn camelCase(str String) String{
  return str.replace(/[._-](\w|$)/g, (_, x)=>(x as String).toUpperCase())
}
export fn cssCase(str String) String{
  return str.replace(/[A-Z]/g, "-$&").toLowerCase()
}
export fn domEach(array Arr, fn) Arr{
  var len=array.length
  for i in 0..len{fn (array[i], i)}
  return array
}
var CharacterCode={LowerA:97, LowerZ:122, UpperA:65, UpperZ:90, Exclamation:33}as const
export fn isHtml(str String) Bool{
  if typeof str !=="string"{
    return false
  }
  var tagStart=str.indexOf("<")
  if tagStart===-1||tagStart>str.length-3{return false}
  var tagChar=str.charCodeAt(tagStart+1)
  return (((tagChar>=CharacterCode.LowerA&&tagChar<=CharacterCode.LowerZ)||(tagChar>=CharacterCode.UpperA&&tagChar<=CharacterCode.UpperZ)||tagChar===CharacterCode.Exclamation)&&str.includes(">", tagStart+2))
}
