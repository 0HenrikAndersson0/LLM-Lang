  fn ByteSize.Humanize(input: this ByteSize, format: String? = null) String{string.IsNullOrWhiteSpace(format)?input.ToString():input.ToString(format)}
  fn ByteSize.Humanize(input: this ByteSize, formatProvider IFormatProvider) String{input.ToString(formatProvider)}
  fn ByteSize.Humanize(input: this ByteSize, format String?, formatProvider IFormatProvider?) String{string.IsNullOrWhiteSpace(format)?input.ToString(formatProvider):input.ToString(format, formatProvider)}
  fn ByteSize.HumanizeWithUnitSystem(input: this ByteSize, unitSystem ByteSizeUnitSystem, format: String? = null, formatProvider: IFormatProvider? = null) String{unitSystem==ByteSizeUnitSystem.Legacy?input.Humanize(format, formatProvider):input.Format(unitSystem, format, formatProvider)}
  fn ByteSize.HumanizeComposite(input: this ByteSize, precision: Int = 2, formatProvider: IFormatProvider? = null, separator: String = " ", toWords: Bool = false) String{
    if precision<1{
      throw new ArgumentOutOfRangeException(nameof(precision), precision, "Precision must be greater than zero.")
    }
    ArgumentNullException.ThrowIfNull(separator)
    formatProvider??=CultureInfo.CurrentCulture
    var culture=formatProvider as CultureInfo
    if culture is not null{
      formatProvider=LocaleNumberFormattingOverrides.GetFormattingNumberFormat(culture)
    }
    var formatter=Configurator.GetFormatter(culture)
    var isNegative=input.Bits<0
    var mut remainingBits=isNegative?(Int64)(-(input.Bits+1))+1:(Int64)input.Bits
    if remainingBits==0{
      return string.Concat("0 ", formatter.DataUnitHumanize(DataUnit.Bit, 0, toSymbol:!toWords))
    }
    var parts=new List<String>(Math.Min(precision, 8))
    fn addPart(bitsPerUnit Int64, unit DataUnit){
      if parts.Count>=precision{
        return
      }
      var count=remainingBits/bitsPerUnit
      if count==0{
        return
      }
      parts.Add(string.Concat(count.ToString(formatProvider), " ", formatter.DataUnitHumanize(unit, count, toSymbol:!toWords)))
      remainingBits%=bitsPerUnit
    }
    addPart((Int64)ByteSize.BytesInExabyte*ByteSize.BitsInByte, DataUnit.Exabyte)
    addPart((Int64)ByteSize.BytesInPetabyte*ByteSize.BitsInByte, DataUnit.Petabyte)
    addPart((Int64)ByteSize.BytesInTerabyte*ByteSize.BitsInByte, DataUnit.Terabyte)
    addPart((Int64)ByteSize.BytesInGigabyte*ByteSize.BitsInByte, DataUnit.Gigabyte)
    addPart((Int64)ByteSize.BytesInMegabyte*ByteSize.BitsInByte, DataUnit.Megabyte)
    addPart((Int64)ByteSize.BytesInKilobyte*ByteSize.BitsInByte, DataUnit.Kilobyte)
    addPart(ByteSize.BitsInByte, DataUnit.Byte)
    addPart(1, DataUnit.Bit)
    return string.Concat(isNegative?NumberFormatInfo.GetInstance(formatProvider).NegativeSign:null , string.Join(separator, parts))
  }
  fn ByteSize.HumanizeCompositeWithUnitSystem(input: this ByteSize, unitSystem ByteSizeUnitSystem, precision: Int = 2, formatProvider: IFormatProvider? = null, separator: String = " ", toWords: Bool = false) String{
    if unitSystem==ByteSizeUnitSystem.Legacy{
      return input.HumanizeComposite(precision, formatProvider, separator, toWords)
    }
    if unitSystem is <ByteSizeUnitSystem.DecimalSi or>ByteSizeUnitSystem.BinaryIec{
      throw new ArgumentOutOfRangeException(nameof(unitSystem), unitSystem, "Unknown byte-size unit system.")
    }
    if precision<1{
      throw new ArgumentOutOfRangeException(nameof(precision), precision, "Precision must be greater than zero.")
    }
    ArgumentNullException.ThrowIfNull(separator)
    formatProvider??=CultureInfo.CurrentCulture
    var culture=formatProvider as CultureInfo
    if culture is not null{
      formatProvider=LocaleNumberFormattingOverrides.GetFormattingNumberFormat(culture)
    }
    var formatter=Configurator.GetFormatter(culture)
    var mut builtInFormatter=formatter as DefaultFormatter
    if builtInFormatter is not null &&formatter.GetType().Assembly !=typeof (DefaultFormatter).Assembly{
      builtInFormatter=null
    }
    var isNegative=input.Bits<0
    var mut remainingBits=isNegative?(Int64)(-(input.Bits+1))+1:(Int64)input.Bits
    var units=unitSystem==ByteSizeUnitSystem.DecimalSi?DecimalCompositeUnits:BinaryCompositeUnits
    if remainingBits==0{
      return string.Concat("0 ", toWords?humanizeUnit(DataUnit.Bit, 0):ByteSize.BitSymbol)
    }
    var parts=new List<String>(Math.Min(precision, units.Length+2))
    for unit in units{
      if parts.Count>=precision{
        break
      }
      var bitsPerUnit=(Int64)unit.Bytes*ByteSize.BitsInByte
      var count=remainingBits/bitsPerUnit
      if count==0{
        continue
      }
      var unitText=toWords?humanizeUnit(unit.DataUnit, count):unit.Symbol
      parts.Add(string.Concat(count.ToString(formatProvider), " ", unitText))
      remainingBits%=bitsPerUnit
    }
    addSmallUnit(ByteSize.BitsInByte, ByteSize.ByteSymbol, DataUnit.Byte)
    addSmallUnit(1, ByteSize.BitSymbol, DataUnit.Bit)
    return string.Concat(isNegative?NumberFormatInfo.GetInstance(formatProvider).NegativeSign:null , string.Join(separator, parts))
    fn addSmallUnit(bitsPerUnit Int64, symbol String, dataUnit DataUnit){
      if parts.Count>=precision{
        return
      }
      var count=remainingBits/bitsPerUnit
      if count==0{
        return
      }
      parts.Add(string.Concat(count.ToString(formatProvider), " ", toWords?humanizeUnit(dataUnit, count):symbol))
      remainingBits%=bitsPerUnit
    }
    fn humanizeUnit(dataUnit DataUnit, count Int64) String{builtInFormatter is not null ?builtInFormatter.DataUnitHumanizeExact(dataUnit, count, toSymbol:false ):formatter.DataUnitHumanize(dataUnit, count, toSymbol:false )}
  }
  Array<CompositeUnit> DecimalCompositeUnits =[new (ByteSize.BytesInDecimalExabyte, "EB", DataUnit.DecimalExabyte), new (ByteSize.BytesInDecimalPetabyte, "PB", DataUnit.DecimalPetabyte), new (ByteSize.BytesInDecimalTerabyte, "TB", DataUnit.DecimalTerabyte), new (ByteSize.BytesInDecimalGigabyte, "GB", DataUnit.DecimalGigabyte), new (ByteSize.BytesInDecimalMegabyte, "MB", DataUnit.DecimalMegabyte), new (ByteSize.BytesInDecimalKilobyte, "kB", DataUnit.DecimalKilobyte)]
  Array<CompositeUnit> BinaryCompositeUnits =[new (ByteSize.BytesInPebibyte, "PiB", DataUnit.BinaryPebibyte), new (ByteSize.BytesInTebibyte, "TiB", DataUnit.BinaryTebibyte), new (ByteSize.BytesInGibibyte, "GiB", DataUnit.BinaryGibibyte), new (ByteSize.BytesInMebibyte, "MiB", DataUnit.BinaryMebibyte), new (ByteSize.BytesInKibibyte, "KiB", DataUnit.BinaryKibibyte)]
  type CompositeUnit(Bytes Int64, Symbol String, DataUnit DataUnit){
  }
  fn ByteSize.Per(size: this ByteSize, interval TimeSpan) ByteRate{new (size, interval)}
}
