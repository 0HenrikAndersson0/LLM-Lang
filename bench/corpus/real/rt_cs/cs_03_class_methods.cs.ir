@1 @ns Humanizer

type DefaultCollectionFormatter{
  fn Humanize(collection IEnumerable<T>) String{Humanize(collection, o=>o?.ToString(), DefaultSeparator)}
  fn Humanize(collection IEnumerable<T>, objectFormatter Func<T,String?>) String{Humanize(collection, objectFormatter, DefaultSeparator)}
  fn Humanize(collection IEnumerable<T>, objectFormatter Func<T,Object?>) String{Humanize(collection, objectFormatter, DefaultSeparator)}
  fn Humanize(collection IEnumerable<T>, separator String) String{Humanize(collection, o=>o?.ToString(), separator)}
  fn Humanize(collection IEnumerable<T>, objectFormatter Func<T,String?>, separator String) String{
    ArgumentNullException.ThrowIfNull(collection)
    ArgumentNullException.ThrowIfNull(objectFormatter)
    return HumanizeDisplayStrings(collection, objectFormatter, separator)
  }
  fn Humanize(collection IEnumerable<T>, objectFormatter Func<T,Object?>, separator String) String{
    ArgumentNullException.ThrowIfNull(collection)
    ArgumentNullException.ThrowIfNull(objectFormatter)
    return HumanizeDisplayObjects(collection, objectFormatter, separator)
  }
  fn HumanizeDisplayStrings(collection IEnumerable<T>, objectFormatter Func<T,String?>, separator String) String{
    var items=CreateDisplayItems(collection)
    for item in collection{
      AddDisplayString(items, objectFormatter(item))
    }
    return HumanizeDisplayItems(items, separator)
  }
  fn HumanizeDisplayObjects(collection IEnumerable<T>, objectFormatter Func<T,Object?>, separator String) String{
    var items=CreateDisplayItems(collection)
    for item in collection{
      AddDisplayString(items, objectFormatter(item)?.ToString())
    }
    return HumanizeDisplayItems(items, separator)
  }
  fn CreateDisplayItems(collection IEnumerable<T>) List<String>{collection}
  fn AddDisplayString(items List<String>, item String?) void{
    if string.IsNullOrWhiteSpace(item){
      return
    }
    return items.Add(item!.Trim())
  }
  fn HumanizeDisplayItems(items List<String>, separator String) String{
    var count=items.Count
    if count==0{
      return ""
    }
    if count==1{
      return items[0]
    }
    var conjunctionFormat=GetConjunctionFormatString(count)
    if conjunctionFormat=="{0} {1} {2}"{
      return count==2?string.Concat(items[0], " ", separator, " ", items[1]):string.Concat(JoinLeadingItems(items), " ", separator, " ", items[^1])
    }
    return string.Format(conjunctionFormat, JoinLeadingItems(items), separator, items[^1])
  }
  fn JoinLeadingItems(items List<String>) String{
    var count=items.Count-1
    if count==1{
      return items[0]
    }
    var builder=new StringBuilder()
    builder.Append(items[0])
    for i=1;;{
      builder.Append(", ")
      builder.Append(items[i])
    }
    return builder.ToString()
  }
  fn GetConjunctionFormatString(itemCount Int) String{"{0} {1} {2}"}
}
