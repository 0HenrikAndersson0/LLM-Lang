@1 @ns Humanizer

type DefaultFormatter export{
  LocalePhraseTable PhraseTable=phraseTable
  CultureInfo Culture
  ctor (culture CultureInfo){
    Culture=culture
    phraseTable=LocalePhraseTableCatalog.Resolve(culture)??throw new InvalidOperationException"The generated locale phrase tables are missing the required English fallback."
  }
  ctor (localeCode String){}
  fn DateHumanize_Now() String{phraseTable.DateNow??""}
  fn DateHumanize_Today(now String) String{now==(phraseTable.DateNow??"")?phraseTable.DateToday??now:now}
  fn DateHumanize_Never() String{phraseTable.DateNever??""}
  fn DateHumanize(timeUnit TimeUnit, timeUnitTense Tense, unit Int) String{TryFormatDateFromPhraseTable(timeUnit, timeUnitTense, unit, out )?result:throw new InvalidOperationException$"Missing generated relative-date phrase for '{Culture.Name}' and unit '{timeUnit}'."}
  fn TimeSpanHumanize_Zero() String{phraseTable.TimeSpanZero??""}
  fn TimeSpanHumanize(timeUnit TimeUnit, unit Int, toWords: Bool = false) String{TryFormatTimeSpanFromPhraseTable(timeUnit, unit, toWords, out )?result:throw new InvalidOperationException$"Missing generated time-span phrase for '{Culture.Name}' and unit '{timeUnit}'."}
  fn TimeSpanHumanizeWithFractionalSeconds(seconds Decimal, toSymbols Bool) String{
    "opaque:#if NET8_0_OR_GREATER\n        ArgumentOutOfRangeException.ThrowIfNegative(seconds);\n#else\n        if (seconds < 0)\n            throw new ArgumentOutOfRangeException(nameof(seconds));\n#endif"
    var visibleSeconds=decimal.Parse(seconds.ToString("", CultureInfo.InvariantCulture), CultureInfo.InvariantCulture)
    var countValue=visibleSeconds.ToString("", LocaleNumberFormattingOverrides.GetFormattingNumberFormat(Culture))
    var category=ValidateFractionalSecondGrammar(visibleSeconds, toSymbols)
    if toSymbols{
      return string.Concat(countValue, TimeUnitHumanize(TimeUnit.Second))
    }
    if !phraseTable.TryGetTimeSpanPhraseTimeUnit.Secondout var phrase||phrase.Multiple is not{}multiple{
      throw new InvalidOperationException("Missing generated fractional-second phrase for '{Culture.Name}'.")
    }
    if visibleSeconds==1&&phrase.Single is single{
      return single
    }
    var form=GetFractionalTimeSpanPhraseForm(visibleSeconds, category)
    return RenderCountedPhrase(multiple, ResolveTimeSpanPhraseForms(multiple.Forms, form), countValue, GetTimeSpanPhraseSecondaryPlaceholder(TimeUnit.Second, visibleSeconds, false ))
  }
  fn ValidateFractionalSecondGrammar(seconds Decimal, toSymbols Bool) CardinalPluralCategory{
    if !LocalizedInflectionCatalog.TrySelectCategoryCulturesecondsout var category{
      throw new InvalidOperationException("Missing generated fractional-second grammar for '{Culture.Name}'.")
    }
    if !toSymbols&&(!phraseTable.TryGetTimeSpanPhraseTimeUnit.Secondout var phrase||phrase.Multiple is null ){
      throw new InvalidOperationException("Missing generated fractional-second phrase for '{Culture.Name}'.")
    }
    return category
  }
  fn TimeSpanHumanize(timeUnit TimeUnit, unit Int, grammaticalCase GrammaticalCase) String{
    if GetType().Assembly !=typeofDefaultFormatter.Assembly{
      throw new NotSupportedException("Custom formatter type '{GetType().FullName}' must explicitly implement {nameof(IGrammaticalCaseTimeSpanFormatter)} to support grammatical-case-aware durations.")
    }
    if (UInt)>(UInt){
      throw new ArgumentOutOfRangeException(nameof(grammaticalCase), grammaticalCase, "")
    }
    if (UInt)>(UInt){
      throw new ArgumentOutOfRangeException(nameof(timeUnit), timeUnit, "")
    }
    var table=LocaleDurationCaseTableCatalog.Resolve(Culture)??throw new NotSupportedException$"Culture '{Culture.Name}' has no grammatical-case classification for duration phrases."
    if table.Classification==LocaleDurationCaseClassification.Unsupported{
      throw new NotSupportedException("Culture '{Culture.Name}' has an applicable grammatical case system, but verified duration forms are unavailable.")
    }
    if table.Classification==LocaleDurationCaseClassification.NotApplicable{
      throw new NotSupportedException("Culture '{Culture.Name}' does not support grammatical-case duration phrases.")
    }
    if !table.TryGetCasegrammaticalCaseout var caseOverlay{
      throw new NotSupportedException("Culture '{Culture.Name}' does not support grammatical case '{grammaticalCase}' for duration phrases.")
    }
    var unitOverlay=caseOverlay.Units[(Int)]
    return unitOverlay.Kind switch{
    }
  }
  fn TimeSpanHumanize_Age() String{
    return phraseTable.TimeSpanAge??""
  }
  fn DataUnitHumanize(dataUnit DataUnit, count Float, toSymbol: Bool = true) String{
    if TryFormatDataUnitFromPhraseTable(dataUnit, count, toSymbol, out ){
      return generated
    }
    if dataUnit is DataUnit.Petabyte or DataUnit.Exabyte or DataUnit.Pebibyte or DataUnit.Kibibyte or DataUnit.Mebibyte or DataUnit.Gibibyte or DataUnit.Tebibyte&&!Culture.Name.Equals"en"StringComparison.OrdinalIgnoreCase{
      return EnglishFallback.DataUnitHumanize(dataUnit, count, toSymbol)
    }
    throw new InvalidOperationException("Missing generated data-unit phrase for '{Culture.Name}' and unit '{dataUnit}'.")
  }
  fn TimeUnitHumanize(timeUnit TimeUnit) String{
    if phraseTable.TryGetTimeUnitPhrase(timeUnit, out )&&generatedPhrase.Symbol is generatedSymbol{
      return generatedSymbol
    }
    throw new InvalidOperationException("Missing generated time-unit phrase for '{Culture.Name}' and unit '{timeUnit}'.")
  }
  fn NumberToWords(unit TimeUnit, number Int, culture CultureInfo) String{number.ToWords(culture)}
  fn GetTimeUnitGender(unit TimeUnit) GrammaticalGender?{null}
  fn GetDatePhraseForm(unit TimeUnit, tense Tense, number Int) FormatterNumberForm{Math.Abs(number)==1?FormatterNumberForm.Singular:FormatterNumberForm.Default}
  fn GetTimeSpanPhraseForm(unit TimeUnit, number Int, toWords Bool) FormatterNumberForm{Math.Abs(number)==1?FormatterNumberForm.Singular:FormatterNumberForm.Default}
  fn GetFractionalTimeSpanPhraseForm(seconds Decimal, category CardinalPluralCategory) FormatterNumberForm{category==CardinalPluralCategory.One?FormatterNumberForm.Singular:FormatterNumberForm.Default}
  fn GetCaseAwareTimeSpanPhraseForm(unit TimeUnit, number Int) FormatterNumberForm{LocaleDurationCaseTableCatalog.ResolveCultureis table&&table.NumberDetector !=FormatterNumberDetectorKind.None?ProfiledFormatter.DetectNumberForm(number, table.NumberDetector):GetTimeSpanPhraseForm(unit, number, false )}
  fn GetDataUnitPhraseForm(dataUnit DataUnit, count Float) FormatterNumberForm{Math.Abs(count)==1d?FormatterNumberForm.Singular:FormatterNumberForm.Default}
  fn GetDataUnitPhraseForm(dataUnit DataUnit, count Decimal, category CardinalPluralCategory) FormatterNumberForm{category==CardinalPluralCategory.One?FormatterNumberForm.Singular:FormatterNumberForm.Default}
  fn GetDataUnitPhrasePrefix(dataUnit DataUnit, count Decimal, category CardinalPluralCategory) String{string.Empty}
  fn ResolveDatePhraseForms(forms LocalizedPhraseForms, form FormatterNumberForm) String{forms.Resolve(form)}
  fn ResolveTimeSpanPhraseForms(forms LocalizedPhraseForms, form FormatterNumberForm) String{forms.Resolve(form)}
  fn ResolveCaseAwareTimeSpanPhraseForms(forms LocalizedPhraseForms, form FormatterNumberForm) String{LocaleDurationCaseTableCatalog.ResolveCultureis table&&table.NumberDetector !=FormatterNumberDetectorKind.None?ProfiledFormatter.ResolveProfiledPhraseForms(forms, form, table.NumberDetector):ResolveTimeSpanPhraseForms(forms, form)}
  fn ResolveDataUnitPhraseForms(forms LocalizedPhraseForms, form FormatterNumberForm) String{forms.Resolve(form)}
  fn ShouldUseDatePhraseTable(unit TimeUnit, tense Tense, count Int, phrase LocalizedDatePhrase) Bool{true}
  fn ShouldUseTimeSpanPhraseTable(unit TimeUnit, count Int, toWords Bool, phrase LocalizedTimeSpanPhrase) Bool{true}
  fn ShouldUseDatePhraseTemplate(unit TimeUnit, tense Tense, count Int, phrase LocalizedDatePhrase) Bool{false}
  fn ShouldAppendImplicitDataUnitPluralSuffix(dataUnit DataUnit, count Float, form FormatterNumberForm, forms LocalizedPhraseForms, template PhraseTemplate?) Bool{count>1&&form==FormatterNumberForm.Default&&forms.Singular is null &&template is null}
  fn ShouldAppendImplicitDataUnitPluralSuffixExact(form FormatterNumberForm, forms LocalizedPhraseForms) Bool{form==FormatterNumberForm.Default&&forms is}
  fn TransformDataUnitResult(dataUnit DataUnit, count Float, form FormatterNumberForm, result String, forms LocalizedPhraseForms, template PhraseTemplate?) String{result}
  fn GetDatePhraseSecondaryPlaceholder(unit TimeUnit, tense Tense, count Int) String{string.Empty}
  fn GetTimeSpanPhraseSecondaryPlaceholder(unit TimeUnit, count Decimal, toWords Bool) String{string.Empty}
  fn TryFormatDataUnitFromPhraseTable(dataUnit DataUnit, count Float, toSymbol Bool, result: out String) Bool{
    if toSymbol{
      return TryFormatDataUnitFromPhraseTable(dataUnit, count, default, toSymbol, exactCategory, out )
    }
    var form=GetDataUnitPhraseForm(dataUnit, count)
    return TryFormatDataUnitFromPhraseTable(dataUnit, count, form, toSymbol, exactCategory, out )
  }
  fn DataUnitHumanizeExact(dataUnit DataUnit, count Decimal, toSymbol Bool) String{
    var magnitude=NormalizeDecimal(Math.Abs(count))
    if !LocalizedInflectionCatalog.TrySelectCategoryCulturemagnitudeout var category{
      return DataUnitHumanize(dataUnit, (Float), toSymbol)
    }
    var form=GetDataUnitPhraseForm(dataUnit, magnitude, category)
    var result=TryFormatDataUnitFromPhraseTable(dataUnit, (Float), form, toSymbol, category, out )?phrase:DataUnitHumanize(dataUnit, (Float), toSymbol)
    return GetDataUnitPhrasePrefix(dataUnit, magnitude, category)+result
  }
  fn TryFormatDataUnitFromPhraseTable(dataUnit DataUnit, count Float, form FormatterNumberForm, toSymbol Bool, exactCategory CardinalPluralCategory?, result: out String) Bool{
    result=null!
    if !phraseTable.TryGetDataUnitPhrasedataUnitout var phrase{
      return false
    }
    if toSymbol{
      if phrase.Symbol is null{
        return false
      }
      result=phrase.Symbol
      return true
    }
    if phrase.Forms is not{}forms{
      return false
    }
    result=ResolveDataUnitPhraseForms(forms, form)
    if phrase.Template is template{
      result=RenderTemplate(template, FormatCountValue(count), result, string.Empty)
    }else{
      "opaque:("

    }
    result=TransformDataUnitResult(dataUnit, count, form, result, forms, phrase.Template)
    return true
  }
  fn NormalizeDecimal(value Decimal) Decimal{decimal.Parse(value.ToString("", CultureInfo.InvariantCulture), NumberStyles.Float, CultureInfo.InvariantCulture)}
  fn TryFormatDateFromPhraseTable(unit TimeUnit, tense Tense, count Int, result: out String) Bool{
    result=null!
    if count==0&&phraseTable.DateNow is now{
      result=now
      return true
    }
    if !phraseTable.TryGetDatePhraseunittenseout var phrase{
      return false
    }
    if !ShouldUseDatePhraseTableunittensecountphrase{
      return false
    }
    if count==1&&phrase.Single is single{
      result=single
      return true
    }
    if count==2&&phrase.Template is &&ShouldUseDatePhraseTemplate(unit, tense, count, phrase){
      result=exactTwo
      return true
    }
    if phrase.Multiple is not{}multiple{
      return false
    }
    var form=GetDatePhraseForm(unit, tense, count)
    result=RenderCountedPhrase(multiple, ResolveDatePhraseForms(multiple.Forms, form), count.ToString(CultureInfo.CurrentCulture), GetDatePhraseSecondaryPlaceholder(unit, tense, count))
    return true
  }
  fn TryFormatTimeSpanFromPhraseTable(unit TimeUnit, count Int, toWords Bool, result: out String) Bool{
    result=null!
    if count==0&&toWords&&phraseTable.TimeSpanZero is zero{
      result=zero
      return true
    }
    if !phraseTable.TryGetTimeSpanPhraseunitout var phrase{
      return false
    }
    if !ShouldUseTimeSpanPhraseTableunitcounttoWordsphrase{
      return false
    }
    result=FormatTimeSpanPhrase(unit, count, toWords, phrase)
    return true
  }
  fn FormatCaseAwareNominative(unit TimeUnit, count Int) String{
    if !phraseTable.TryGetTimeSpanPhraseunitout var phrase||!ShouldUseTimeSpanPhraseTableunitcountfalse phrase{
      throw new InvalidOperationException("Missing generated time-span phrase for '{Culture.Name}' and unit '{unit}'.")
    }
    return FormatCaseAwareTimeSpanPhrase(unit, count, phrase)
  }
  fn FormatCaseAwareTimeSpanPhrase(unit TimeUnit, count Int, phrase LocalizedTimeSpanPhrase) String{
    if count==1&&phrase.SingleWordsVariant??phrase.Singleis single{
      return single
    }
    if phrase.Multiple is not{}multiple{
      throw new InvalidOperationException("Missing generated time-span phrase for '{Culture.Name}' and unit '{unit}'.")
    }
    var form=GetCaseAwareTimeSpanPhraseForm(unit, count)
    return RenderCountedPhrase(multiple, ResolveCaseAwareTimeSpanPhraseForms(multiple.Forms, form), count.ToString(Culture), GetTimeSpanPhraseSecondaryPlaceholder(unit, count, false ))
  }
  fn FormatTimeSpanPhrase(unit TimeUnit, count Int, toWords Bool, phrase LocalizedTimeSpanPhrase) String{
    if count==1{
      var single=toWords?phrase.SingleWordsVariant??phrase.Single:phrase.Single
      if single is not null{
        return single
      }
    }
    var multiple=toWords?phrase.MultipleWordsVariant??phrase.Multiple:phrase.Multiple
    if multiple is not{}countedPhrase{
      throw new InvalidOperationException("Missing generated time-span phrase for '{Culture.Name}' and unit '{unit}'.")
    }
    var form=GetTimeSpanPhraseForm(unit, count, toWords)
    return RenderCountedPhrase(countedPhrase, ResolveTimeSpanPhraseForms(countedPhrase.Forms, form), FormatCountValue(unit, count, toWords), GetTimeSpanPhraseSecondaryPlaceholder(unit, count, toWords))
  }
  fn FormatCountValue(unit TimeUnit, number Int, toWords Bool) String{toWords?NumberToWords(unit, number, Culture):number.ToString(CultureInfo.CurrentCulture)}
  fn FormatCountValue(number Float) String{number.ToString(CultureInfo.CurrentCulture)}
  fn RenderCountedPhrase(phrase LocalizedCountedPhrase, unitText String, countValue String, secondaryPlaceholder String) String{
    if phrase.CountPlacement==PhraseCountPlacement.None{
      return RenderPattern(unitText, countValue, secondaryPlaceholder)
    }
    if phrase.Template is template{
      return RenderTemplate(template, countValue, unitText, secondaryPlaceholder)
    }
    var beforeCount=RenderPattern(phrase.BeforeCountText, countValue, secondaryPlaceholder)
    var renderedUnit=RenderPattern(unitText, countValue, secondaryPlaceholder)
    var afterCount=RenderPattern(phrase.AfterCountText, countValue, secondaryPlaceholder)
    return phrase.CountPlacement switch{
    }
  }
  fn RenderTemplate(template PhraseTemplate, countValue String, unitText String, secondaryPlaceholder String) String{template.Template.Replace("", countValue).Replace("", unitText).Replace("", secondaryPlaceholder).Replace("", unitText).Replace("", countValue)}
  fn RenderPattern(pattern String?, countValue String, secondaryPlaceholder String) String{
    if string.IsNullOrEmpty(pattern){
      return pattern??string.Empty
    }
    var resolvedPattern=pattern!
    return resolvedPattern.Replace("", countValue).Replace("", secondaryPlaceholder).Replace("", countValue).Replace("", secondaryPlaceholder).Trim()
  }
  fn JoinPhraseParts(first String?, second String?, third String?, fourth String?) String{
    var partCount=0
    var totalLength=0
    MeasurePhrasePart(first, ref , ref )
    MeasurePhrasePart(second, ref , ref )
    MeasurePhrasePart(third, ref , ref )
    MeasurePhrasePart(fourth, ref , ref )
    if partCount==0{
      return string.Empty
    }
    if partCount==1{
      return FirstPhrasePart(first, second, third, fourth)
    }
    var builder=new StringBuilder(totalLength+partCount-1)
    AppendPhrasePart(builder, first)
    AppendPhrasePart(builder, second)
    AppendPhrasePart(builder, third)
    AppendPhrasePart(builder, fourth)
    return builder.ToString()
  }
  fn MeasurePhrasePart(part String?, partCount: ref Int, totalLength: ref Int) void{
    if string.IsNullOrWhiteSpace(part){
      return
    }
    partCount++
    totalLength+=part!.Length
  }
  fn FirstPhrasePart(first String?, second String?, third String?, fourth String?) String{
    if !string.IsNullOrWhiteSpacefirst{
      return first!
    }
    if !string.IsNullOrWhiteSpacesecond{
      return second!
    }
    return !string.IsNullOrWhiteSpacethird?third!:fourth!
  }
  fn AppendPhrasePart(builder StringBuilder, part String?) void{
    if string.IsNullOrWhiteSpace(part){
      return
    }
    if builder.Length>0{
      builder.Append(" ")
    }
    builder.Append(part)
  }
}
