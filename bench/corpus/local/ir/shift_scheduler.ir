@1

opaque type Time24="`${number}:${number}`"
opaque type IsoWeekday=1|2|3|4|5|6|7
type Window export interface{
  IsoWeekday day
  Time24 from
  Time24 to
}
type Staff export interface{
  String id
  String name
  readonly Skill[] skills
  readonly Window[] windows
  Int weeklyQuarters
}
opaque type Skill="opening"|"closing"|"register"|"barista"|"stock"
type Shift export interface{
  String personId
  IsoWeekday day
  Time24 start
  Int quarters
  Skill skill
}
type Roster export interface{
  Array<Shift> shifts
  Array<String> unsatisfied
  Array<String> unfilled
}
export fn timeOf(minutes Int) Time24{
  var wrapped=((minutes%1440)+1440)%1440
  return "{String(Math.floor(wrapped/60)).padStart(2, \"0\")}:{String(wrapped%60).padStart(2, \"0\")}"
}
export fn overlapQuarters(a Window, b Window) Int{
  if a.day !==b.day{
    return 0
  }
  var a0=minutes(a.from )
  var a1=minutes(a.to)
  var b0=minutes(b.from )
  var b1=minutes(b.to)
  var lo=Math.max(a0, b0)
  var hi=Math.min(a1, b1)
  return Math.max(0, Math.floor((hi-lo)/15))
}
fn minutes(t Time24) Int{
  var m=/^([01]\d|2[0-3]):([0-5]\d)$/.exec(t)
  if !m{
    throw new RangeError("bad time: {JSON.stringify(t)}")
  }
  return Number(m[1])*60+Number(m[2])
}
export fn buildRoster(demand: readonly{day:IsoWeekday;start:Time24;quarters:number;skill:Skill}[], staff: readonly Staff[]) Roster{
  var shifts: Array<Shift> =[]
  var remaining=new Map(staff.map((s)=>[s.id, s.weeklyQuarters]))
  var unfilled: Array<String> =[]
  var ordered=[...demand].sort((x, y)=>x.day-y.day||minutes(x.start)-minutes(y.start))
  for slot in ordered{
    var candidates=staff.filter((s)=>s.skills.includes(slot.skill)).map((s)=>({staff:s, cover:Math.max(0, ...s.windows.map((w)=>overlapQuarters(w, slotOf(slot))))})).filter((c)=>c.cover>0&&(remaining.get(c.staff.id)??0)>0).sort((x, y)=>Math.min(remaining.get(y.staff.id)??0, y.cover)-Math.min(remaining.get(x.staff.id)??0, x.cover)||x.staff.id.localeCompare(y.staff.id))
    if candidates.length===0{
      unfilled.push("{slot.day}/{slot.skill}")
      "opaque:continue;"
    }
    var pick=candidates[0]
    var booked=Math.min(slot.quarters, pick.cover, remaining.get(pick.staff.id)??0)
    shifts.push({personId:pick.staff.id, day:slot.day, start:slot.start, quarters:booked, skill:slot.skill})
    remaining.set(pick.staff.id, (remaining.get(pick.staff.id)??0)-booked)
  }
  var unsatisfied=[...remaining.entries()].filter(([, q])=>q>0).map(([id])=>id).sort()
  return {shifts:shifts.sort((x, y)=>x.day-y.day||minutes(x.start)-minutes(y.start)), unsatisfied, unfilled:[...new Set(unfilled)]}
}
fn slotOf(slot) Window{
  var s=minutes(slot.start)
  return {day:slot.day, from :slot.start, to:timeOf(s+slot.quarters*15)}
}
export fn weeklyTotals(roster Roster, staff: readonly Staff[]) Map<String,Int>{
  var totals=new Map(staff.map((s)=>[s.id, 0]))
  for shift in roster.shifts{totals.set(shift.personId, (totals.get(shift.personId)??0)+shift.quarters)}
  return totals
}
