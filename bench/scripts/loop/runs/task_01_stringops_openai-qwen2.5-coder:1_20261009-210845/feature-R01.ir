@1 @ns Demo.Guide

export fn CompactLabel(String s) String{
  var trimmed = s.trim()
  if trimmed == ""{return "-"}
  var words = trimmed.split(" ").filter(word => word != "")
  var compacted = words.map(word => word.charAt(0).toUpperCase()).join("")
  return compacted.length > 6 ? compacted.substring(0, 6) : compacted
}
