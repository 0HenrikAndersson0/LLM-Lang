@1 @ns Demo.Tidy

export fn Tidy(List<String> xs) List<String>{
  return xs.filter(s=>{
    var t=s.trim()
    t.length>0
  })
  .map(s=>{
    var words=s.split(" ")
    return words.map(w=>{
      if(words.indexOf(w)==0) return w.toLowerCase()
      return w[0].toUpperCase()+w.slice(1)
    })
    .join("")
  })
  .slice(0, 3)
}
